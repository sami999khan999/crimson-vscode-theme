  "semanticTokenColors": {
    "namespace": "#8fa9ae",
    "class": "#8fa9ae",
    "type": "#8fa9ae",
    "interface": "#8fa9ae",
    "enum": "#8fa9ae",
    "typeParameter": "#759397",
    "enumMember": "#c4a46a",
    "function": "#a4b1c4",
    "method": "#a4b1c4",
    "macro": "#c4a46a",
    "decorator": "#c4a46a",
    "variable": "#d6d6da",
    "variable.readonly": "#c4a46a",
    "variable.defaultLibrary": "#c4a46a",
    "parameter": {
      "foreground": "#d0cfcd",
      "italic": true
    },
    "property": "#8bb0aa",
    "property.readonly": "#8bb0aa",
    "keyword": "#a3889a",
    "selfKeyword": {
      "foreground": "#aea29f",
      "italic": true
    },
    "string": "#8ea482",
    "number": "#c98a5e",
    "regexp": "#8bb0aa",
    "operator": "#8fa9ae",
    "comment": {
      "foreground": "#796d72",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#796d72",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#958b8f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "comment keyword.codetag.notation"
      ],
      "settings": {
        "foreground": "#9e979a",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#a3889a",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#8a7383",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#8fa9ae",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#a3889a",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9e979a",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#8ea482",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes, regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#8bb0aa",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#aea29f",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers, constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#c98a5e",
        "fontStyle": ""
      }
    },
    {
      "name": "Named constants",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#c4a46a",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#a4b1c4",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators, macros",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#c4a46a",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#8fa9ae",
        "fontStyle": ""
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#759397",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#d6d6da",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#d0cfcd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this, self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#aea29f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties, keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8bb0aa",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#8c9bb0",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8c9bb0",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag brackets",
      "scope": [
